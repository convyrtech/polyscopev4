{
    "extends": "@whalescope/tsconfig/base.json",
    "compilerOptions": {
        "lib": [
            "ESNext"
        ],
        "module": "CommonJS",
        "target": "ESNext",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "outDir": "dist"
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "src/test_*.ts",
        "src/scripts/*.ts",
        "src/check_markets.ts",
        "src/debug_api.ts"
    ]
}