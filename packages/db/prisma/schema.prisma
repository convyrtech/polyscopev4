datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. App Users (Subscribers)
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
  
  // Relations
  watchlist Watchlist[]
}

// 2. Polymarket Whales (The "Insiders")
model Whale {
  address   String   @id // Wallet Address
  alias     String?  // "TrumpWhale", etc.
  
  // Stats (Updated via Aggregation)
  winrate   Float    @default(0)
  pnl       Float    @default(0)
  volume    Float    @default(0)
  score     Float    @default(0) // "Whale Score"
  lastActive DateTime @default(now()) // To filter out dead wallets
  lastAnalyzed DateTime @default(now()) // Cache invalidation logic
  
  // Tags
  tags      String   @default("") // Comma-separated: "Smart,Insider,HighRoller"

  // Funding analysis (added for insider detection)
  fundingAnalyzedAt DateTime?
  fundingSource     String?
  fundingSourceTag  String?

  // Relations
  signals   Signal[]
  followers Watchlist[]

  // Indexes for common queries
  @@index([lastActive])
  @@index([score])
}

// 3. Signals (Trades/Bets)
model Signal {
  id              String   @id @default(cuid()) // or txHash
  txHash          String   @unique
  timestamp       DateTime
  
  // Market Info
  marketSlug      String
  conditionId     String
  tokenId         String?  // YES/NO token ID for order book lookups
  outcome         String   // "Yes" / "No"
  
  // Trade Info
  side            String   // "BUY" / "SELL"
  price           Float
  amountUSD       Float
  
  // Analysis
  status          String   @default("OPEN") // OPEN, WON, LOST
  aiScore         Float    @default(0)      // Algo confidence
  roi             Float?                    // Final result %
  isShadow        Boolean  @default(false)  // If true, it was a "Shadow Bet" simulation
  tags            String   @default("")     // Classification tags (SMART_ENTRY, FOMO, etc.)
  strategyName    String?                   // e.g. "SNIPER", "INSIDER"
  betAmount       Float?                    // Calculated bet size in USD
  
  // Relations
  whaleAddress    String
  whale           Whale    @relation(fields: [whaleAddress], references: [address])
  positions       PaperPosition[]

  // Indexes for common queries
  @@index([marketSlug])
  @@index([timestamp])
  @@index([whaleAddress])
  @@index([status])
  @@index([whaleAddress, status])
}

// 4. Watchlist (User -> Whale)
model Watchlist {
  userId       String
  whaleAddress String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])
  whale        Whale    @relation(fields: [whaleAddress], references: [address])

  @@id([userId, whaleAddress])
}

// 5. Strategy Lab (Paper Trading)
model Strategy {
  id             String   @id @default(cuid())
  name           String
  status         String   @default("ACTIVE") // ACTIVE, PAUSED
  config         Json     // { "takeProfit": 1.5, "stopLoss": 0.8, "whales": ["0x..."] }
  initialBudget  Float    @default(10000)  // Starting capital
  currentBalance Float    @default(10000)  // Available funds
  createdAt      DateTime @default(now())
  
  positions PaperPosition[]
}

model PaperPosition {
  id          String    @id @default(cuid())
  strategyId  String
  signalId    String?   // Link to original signal
  marketSlug  String
  outcome     String    // "Yes", "No", "Donald Trump"
  tokenId     String?   // Polymarket token ID for order book lookups
  
  entryPrice  Float
  amountUSD   Float     // Position size in USD
  shares      Float?    // Actual shares purchased after slippage
  status      String    @default("OPEN") // OPEN, CLOSED_WON, CLOSED_LOST, CLOSED_TP, CLOSED_SL
  
  // Cost tracking (Phase 1)
  entrySlippage   Float?    // Entry slippage cost in USD
  exitSlippage    Float?    // Exit slippage cost in USD  
  gasCost         Float?    // Gas cost in USD (entry + exit)
  latencyMs       Int?      // Simulated reaction latency in ms
  totalSlippage   Float?    // Total slippage (entry + exit)
  exitValue       Float?    // Total exit value in USD
  
  exitPrice   Float?
  exitReason  String?   // "TP", "SL", "PANIC", "RESOLVED"
  pnl         Float?
  
  openedAt    DateTime  @default(now())
  closedAt    DateTime?

  strategy    Strategy  @relation(fields: [strategyId], references: [id])
  signal      Signal?   @relation(fields: [signalId], references: [id])
}
