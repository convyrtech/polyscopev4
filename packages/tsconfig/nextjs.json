{
    "extends": "./base.json",
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "preserve",
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": [
                "./*"
            ]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx"
    ]
}