# ============================================================================
# WhaleScope Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values

# Database
DATABASE_URL="postgresql://whale:password@localhost:5432/whalescope"

# External APIs
ALCHEMY_API_KEY="your-alchemy-api-key-here"

# API Configuration
API_PORT=3001
WEB_PORT=3000

# External Service URLs (optional - defaults shown)
# POLYMARKET_DATA_API="https://data-api.polymarket.com"
# POLYMARKET_GAMMA_API="https://gamma-api.polymarket.com"

# CORS Origins (comma-separated)
# ALLOWED_ORIGINS="https://polymarket.com,http://localhost:3000"

# Monitoring (optional)
# SENTRY_DSN="https://xxx@sentry.io/xxx"

# Docker Postgres (used by docker-compose.yml)
POSTGRES_USER=whale
POSTGRES_PASSWORD=password
POSTGRES_DB=whalescope
